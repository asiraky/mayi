{
  "name": "may-i",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asiraky/mayi.git"
  },
  "bugs": {
    "url": "https://github.com/asiraky/mayi/issues"
  },
  "homepage": "https://mayi.sh",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "xcode>uuid": "11.1.1"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "changeset:check": "node ./scripts/check-changeset.mjs",
    "changeset:status": "changeset status",
    "dev": "pnpm --filter @mayi/server dev",
    "dev:site": "pnpm --filter @mayi/site dev",
    "dev:web": "pnpm --filter @mayiapp/sdk build && pnpm --filter @mayi/web dev",
    "dev:mobile": "pnpm --filter @mayi/mobile start",
    "typecheck": "pnpm --filter @mayiapp/sdk build && pnpm -r --if-present typecheck",
    "smoke-test": "node ./scripts/smoke-test/smoke.mjs",
    "test": "vitest run && pnpm --filter @mayiapp/sdk test:package && pnpm --filter @mayiapp/eve test:package",
    "test:watch": "vitest",
    "db:generate": "dotenv -e .env -- pnpm --filter @mayi/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @mayi/db migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @mayi/db seed",
    "deploy:site": "node ./scripts/preflight-site-deploy.mjs && pnpm --filter @mayi/site build && wrangler deploy --config apps/site/wrangler.jsonc",
    "lint": "eslint .",
    "release": "node ./scripts/release-packages.mjs",
    "release:dry-run": "node ./scripts/release-packages.mjs --dry-run",
    "version-packages": "changeset version && corepack pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.115.0"
  }
}
