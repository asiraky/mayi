{
  "name": "may-i",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asiraky/mayi.git"
  },
  "bugs": { "url": "https://github.com/asiraky/mayi/issues" },
  "homepage": "https://github.com/asiraky/mayi#readme",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @mayi/server dev",
    "dev:web": "pnpm --filter @mayi/web dev",
    "dev:mobile": "pnpm --filter @mayi/mobile start",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @mayi/db generate",
    "db:migrate": "pnpm --filter @mayi/db migrate",
    "db:seed": "pnpm --filter @mayi/db seed",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
