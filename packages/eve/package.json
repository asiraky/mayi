{
  "name": "@mayiapp/eve",
  "version": "0.3.0",
  "description": "Durable Mayi approval channel for Eve agents",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/asiraky/mayi",
    "directory": "packages/eve"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ./scripts/normalize-source-maps.mjs",
    "prepack": "pnpm build",
    "test:harness": "cd test-fixtures/approval-harness && eve eval --skip-report --timeout 30000 --max-concurrency 1",
    "test:package": "node ./scripts/test-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mayiapp/sdk": "workspace:^0.3.0"
  },
  "peerDependencies": {
    "eve": "0.24.2"
  },
  "devDependencies": {
    "eve": "0.24.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  }
}
