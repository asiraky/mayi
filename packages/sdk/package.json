{
  "name": "@mayiapp/sdk",
  "version": "0.3.0",
  "description": "TypeScript client and verification utilities for May I? approvals",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./callback-state": {
      "types": "./dist/callback-state.d.ts",
      "import": "./dist/callback-state.js"
    },
    "./webhook-verifier": {
      "types": "./dist/webhook-verifier.d.ts",
      "import": "./dist/webhook-verifier.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mayi": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/asiraky/mayi",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ./scripts/normalize-source-maps.mjs",
    "prepack": "pnpm build",
    "test:package": "node ./scripts/test-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@mayi/contracts": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
