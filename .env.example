DATABASE_URL=postgres://mayi:mayi@localhost:5432/mayi
# Only if 5432 is already taken by another project's Postgres. docker-compose reads
# this; DATABASE_URL above must be changed to match.
# POSTGRES_PORT=5433
PUBLIC_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
RECEIPT_ISSUER=http://localhost:3000
RECEIPT_AUDIENCE=local-executor
# Generate with: pnpm --filter @mayi/receipts generate-key
RECEIPT_PRIVATE_JWK=
RECEIPT_PUBLIC_JWK=
OBJECT_STORE=filesystem
OBJECT_DIRECTORY=./data/objects
EXPO_ACCESS_TOKEN=
BOOTSTRAP_SECRET=
RETENTION_DAYS=90
CRON_SECRET=
# JSON object mapping receipt audiences to target credentials.
CONSUMER_API_KEYS={}
# S3-compatible deployments set OBJECT_STORE=s3 and the values below.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Provider endpoint accepting {to,subject,text} with bearer authentication.
EMAIL_API_URL=
EMAIL_API_KEY=
