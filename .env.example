DATABASE_URL=postgres://mayi:mayi@localhost:5432/mayi
# Only if 5432 is already taken by another project's Postgres. docker-compose reads
# this; DATABASE_URL above must be changed to match.
# POSTGRES_PORT=5433
PUBLIC_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
RECEIPT_ISSUER=http://localhost:3000
RECEIPT_AUDIENCE=local-executor
# Generate with: pnpm --filter @mayi/receipts generate-key
RECEIPT_PRIVATE_JWK=
RECEIPT_PUBLIC_JWK=
# JSON array of old public JWKs retained while previously issued receipts remain valid.
RECEIPT_PREVIOUS_PUBLIC_JWKS=[]
OBJECT_STORE=filesystem
OBJECT_DIRECTORY=./data/objects
EXPO_ACCESS_TOKEN=
BOOTSTRAP_SECRET=
RETENTION_DAYS=90
CRON_SECRET=
# Set only behind a trusted proxy that overwrites this header with one client IP.
# Direct Node uses the socket peer; Vercel selects x-vercel-forwarded-for automatically.
# OAUTH_REGISTRATION_TRUSTED_IP_HEADER=x-mayi-client-ip
# Public auth throttles use the same trust model. Caddy overwrites X-Forwarded-For;
# configure a different header only when your proxy overwrites it with one client IP.
# AUTH_TRUSTED_IP_HEADER=x-mayi-client-ip
# JSON object mapping receipt audiences to target credentials.
CONSUMER_API_KEYS={}
# S3-compatible deployments set OBJECT_STORE=s3 and the values below.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Postmark delivers approval emails; FROM_EMAIL must be a verified sender signature.
POSTMARK_SERVER_TOKEN=
FROM_EMAIL=
# Where email deep links land; defaults to PUBLIC_ORIGIN when unset.
WEB_ORIGIN=
