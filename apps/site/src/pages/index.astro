---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "home");
if (!page) throw new Error("Missing home page content");
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="hero">
    <div>
      <p class="eyebrow">{page.data.eyebrow}</p>
      <h1>Before the agent acts,<br /><em>ask the human.</em></h1>
      <p class="hero-copy">{page.data.description}</p>
      <div class="actions">
        <a class="button" href="https://app.mayi.sh">{page.data.primaryCta}</a>
        <a class="text-link" href="/docs">{page.data.secondaryCta} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="receipt-card" aria-label="Example approval receipt">
      <div class="card-top"><span>Approval request</span><span class="status">Approved</span></div>
      <dl>
        <div><dt>Action</dt><dd>deploy.release</dd></div>
        <div><dt>Target</dt><dd>production</dd></div>
        <div><dt>Release</dt><dd>sha256:8c7f...</dd></div>
        <div><dt>Expires</dt><dd>in 12 minutes</dd></div>
      </dl>
      <p class="signed">✓ Signed for this exact action</p>
    </div>
  </section>

  <section class="explanation prose">
    <Content />
  </section>

  <section class="steps" aria-labelledby="steps-title">
    <p class="eyebrow">How it works</p>
    <h2 id="steps-title">One request. One decision. One exact action.</h2>
    <ol>
      <li><span>01</span><h3>Describe</h3><p>The agent submits the action, target, evidence, and expiry.</p></li>
      <li><span>02</span><h3>Decide</h3><p>An eligible person reviews the frozen request and answers.</p></li>
      <li><span>03</span><h3>Verify</h3><p>The executor checks the signed receipt before it does any work.</p></li>
    </ol>
  </section>
</BaseLayout>
