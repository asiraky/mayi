  </section>

  <footer class="border-t border-border">
    <div
      class="mx-auto flex w-[min(980px,100%-3rem)] flex-col gap-2 py-8 text-[13px] text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
    >
      <span>Open source · Apache-2.0 · Self-host it</span>
      <a href="https://github.com/asiraky/mayi/blob/main/SECURITY.md" class="hover:text-foreground">
        Report a security issue →
      </a>
    </div>
  </footer>
</MarketingLayout>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The page holds for a beat before it settles, the way a request does.
  const steps = document.querySelectorAll<HTMLElement>("[data-reveal]");
  for (const step of steps) {
    if (reduced) break;
    step.style.opacity = "0";
    step.style.transform = "translateY(10px)";
    step.style.transition = "opacity 700ms ease, transform 700ms cubic-bezier(0.2,0.7,0.2,1)";
  }
  if (!reduced) {
    requestAnimationFrame(() => {
      steps.forEach((step, i) => {
        setTimeout(
          () => {
            step.style.opacity = "1";
            step.style.transform = "translateY(0)";
          },
          160 + i * 190,
        );
      });
    });
  }

  // Sections below the fold arrive on the same slow beat as the hero.
  const sections = document.querySelectorAll<HTMLElement>("[data-io]");
  if (!reduced && "IntersectionObserver" in window) {
    for (const section of sections) {
      section.style.opacity = "0";
      section.style.transform = "translateY(14px)";
      section.style.transition = "opacity 800ms ease, transform 800ms cubic-bezier(0.2,0.7,0.2,1)";
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.style.opacity = "1";
          el.style.transform = "translateY(0)";
          io.unobserve(el);
        }
      },
      { rootMargin: "0px 0px -12% 0px" },
    );
    for (const section of sections) io.observe(section);
  }

  // Counts how long this one request has been held — since you arrived.
  const clock = document.querySelector<HTMLElement>("[data-held-clock]");
  if (clock) {
    let seconds = 0;
    setInterval(() => {
      seconds += 1;
      const m = String(Math.floor(seconds / 60)).padStart(2, "0");
      const s = String(seconds % 60).padStart(2, "0");
      clock.textContent = `${m}:${s}`;
    }, 1000);
  }

  // Move a decimal after the fact and watch the signature stop agreeing.
  const toggle = document.querySelector<HTMLButtonElement>("[data-tamper-toggle]");
  const amount = document.querySelector<HTMLElement>("[data-tamper-amount]");
  const digest = document.querySelector<HTMLElement>("[data-tamper-digest]");
  const verdict = document.querySelector<HTMLElement>("[data-tamper-verdict]");
  const dot = document.querySelector<HTMLElement>("[data-tamper-dot]");
  const text = document.querySelector<HTMLElement>("[data-tamper-text]");

  if (toggle && amount && digest && verdict && dot && text) {
    const valid = {
      amount: "USD 48,000.00",
      digest: "a91f…7c02",
      text: "receipt valid — signed by dana@northwind",
      label: "Edit the amount after approval",
    };
    const tampered = {
      amount: "USD 480,000.00",
      digest: "d47b…1e88",
      text: "no signature for this action — refused",
      label: "Put it back",
    };

    let isTampered = false;
    toggle.addEventListener("click", () => {
      isTampered = !isTampered;
      const state = isTampered ? tampered : valid;

      amount.textContent = state.amount;
      digest.textContent = state.digest;
      text.textContent = state.text;
      toggle.textContent = state.label;
      toggle.setAttribute("aria-pressed", String(isTampered));

      amount.classList.toggle("text-destructive", isTampered);
      digest.classList.toggle("text-destructive", isTampered);
      verdict.className = isTampered
        ? "mt-6 flex items-center gap-2.5 rounded-lg border border-destructive/30 bg-destructive/8 px-4 py-3 font-mono text-[12px] text-destructive"
        : "mt-6 flex items-center gap-2.5 rounded-lg border border-primary/25 bg-primary/8 px-4 py-3 font-mono text-[12px] text-primary-ink";
      dot.className = isTampered ? "h-1.5 w-1.5 rounded-full bg-destructive" : "h-1.5 w-1.5 rounded-full bg-primary";
    });
  }
</script>
