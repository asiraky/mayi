---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"docs">;
  entries: CollectionEntry<"docs">[];
}

const { entry, entries } = Astro.props;
---

<BaseLayout title={`${entry.data.title} | May I?`} description={entry.data.description}>
  <div class="mx-auto grid w-[min(980px,100%-3rem)] grid-cols-1 gap-0 pt-12 lg:grid-cols-[190px_minmax(0,1fr)] lg:gap-14">
    <aside class="border-b border-border pb-6 lg:border-0 lg:pt-2 lg:pb-0">
      <p class="text-[11px] font-medium tracking-[0.09em] text-muted-foreground uppercase">Documentation</p>
      <nav
        aria-label="Documentation"
        class="mt-5 flex gap-1 overflow-x-auto lg:grid lg:gap-0.5 lg:overflow-visible"
      >
        {
          entries.map((item) => (
            <a
              href={item.id === "introduction" ? "/docs" : `/docs/${item.id}`}
              aria-current={item.id === entry.id ? "page" : undefined}
              class:list={[
                "rounded-lg px-3 py-2 text-[14px] whitespace-nowrap transition-colors",
                item.id === entry.id
                  ? "bg-foreground/6 font-medium text-foreground"
                  : "text-muted-foreground hover:text-foreground",
              ]}
            >
              {item.data.title}
            </a>
          ))
        }
      </nav>
    </aside>

    <article class="prose min-h-[70vh] min-w-0 max-w-full pt-10 pb-[12vh] lg:pt-2">
      <h1 class="max-w-[18ch] text-[clamp(2rem,4.6vw,3.2rem)] leading-[1.02] font-semibold text-foreground">
        {entry.data.title}
      </h1>
      <p class="mt-5 max-w-[54ch] text-[19px] leading-[1.55] text-body">{entry.data.description}</p>
      <hr class="mt-10 mb-2 max-w-none border-0 border-t border-border" />
      <slot />
    </article>
  </div>
</BaseLayout>
