---
/**
 * The receipt mark: a perforated slip with the approver's tick. Geometry is symmetric
 * about x=14 (body 7–21, check 9.75–18.25), which is what keeps it sitting straight
 * next to the wordmark at header sizes.
 *
 * The slip draws with currentColor so it follows whatever ink surrounds it; the check
 * stays --primary in BOTH schemes — same rule as the pending dot: the brand blue is a
 * graphic fill here, not text, so it does not flip with the theme.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 28 28" fill="none" aria-hidden="true" class={className}>
  <path
    d="M7 3.5H21V21.5L19.25 24L17.5 21.5L15.75 24L14 21.5L12.25 24L10.5 21.5L8.75 24L7 21.5Z"
    class="stroke-current"
    stroke-width="2"
    stroke-linejoin="round"></path>
  <path
    d="M9.75 12.75L12.75 15.75L18.25 9.25"
    class="stroke-primary"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
